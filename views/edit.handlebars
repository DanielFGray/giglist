<h2>Edit</h2>

<form class="edit-form" role="form" action="/save/{{data.id}}" method="POST">
  <div id="markdown" class="card">
    <div class="card-block">
      <textarea id="markdown-editor" name="markdown" autofocus>{{data.list}}</textarea>
    </div>
    <div class="card-footer">
      <button type="reset" class="btn btn-danger btn-sm">Reset</button>
      <button type="submit" class="btn btn-success btn-sm">Save</button>
    </div>
  </div>
</form>
