<h1>things</h1>

<div>
  <a href="/edit/new" class="btn btn-warning">New</a>
</div>

<div class="card-deck">
  {{#each data}}
  <div class="card" id="list_{{id}}">
    <div class="card-block list-preview">
      {{{list}}}
    </div>
    <div class="card-footer">
      <a href="#" class="btn btn-primary btn-sm" style="cursor:not-allowed">View</a>
      <a href="/edit/{{id}}" class="btn btn-success btn-sm">Edit</a>
      <a href="/del/{{id}}" class="btn btn-danger btn-sm">Delete</a>
    </div>
  </div>
  {{/each}}
</div>
