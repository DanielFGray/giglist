<h1>Setlists</h1>
{{#each data}}
  <div id="list_{{id}}">
    <div class="list_content">
      {{{list}}}
    </div>
    <a href="/edit/{{id}}" class="btn btn-primary">Edit</a>
  </div>
{{/each}}
<br>
<div id="new">
  <form class="save-form" role="form" action="/new" method="POST">
    <!-- Heading: -->
    <button type="submit" class="btn btn-warning">New</button>
    <input type="text" id="markdown-heading" name="title"/>
  </form>
</div>
