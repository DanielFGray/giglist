{
  "apiVersion": "server-ansible/v2",
  "name": "giglist",
  "postgres": [{ "database": "giglist", "extensions": ["citext", "pgcrypto", "uuid-ossp"] }],
  "services": [
    {
      "name": "giglist-api",
      "image": "registry.cluster:5000/giglist",
      "hostPort": "dynamic",
      "containerPort": 3000,
      "healthCheck": { "type": "http", "path": "/healthz" },
      "cpu": 300,
      "memoryMB": 640,
      "networkMode": "bridge",
      "command": "bun",
      "args": ["run", "start"],
      "migrate": {
        "command": "bun",
        "args": ["run", "migrate"],
        "secrets": [
          {
            "_tag": "PostgresCredentials",
            "database": "giglist",
            "login": "migration",
            "urlEnv": "DATABASE_URL"
          },
          {
            "_tag": "PostgresCredentials",
            "database": "giglist",
            "login": "api",
            "urlEnv": "AUTH_DATABASE_URL", "usernameEnv": "DATABASE_AUTHENTICATOR"
          }
        ]
      },
      "routes": [
        {
          "host": "giglist.dfg.rocks",
          "pathPrefixes": ["/api"],
          "responseHeaders": [
            { "name": "Strict-Transport-Security", "value": "max-age=31536000" },
            { "name": "X-Content-Type-Options", "value": "nosniff" },
            { "name": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "name": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
            {
              "name": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'sha256-6iG6gjRLt1RJOrZKCJT5mXW5bMDTD/CnFfjQN1bpmpU='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.googleapis.com https://fonts.gstatic.com; media-src 'self' blob: data:; worker-src 'self' blob:; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://open.spotify.com https://player.vimeo.com https://www.tiktok.com https://www.instagram.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
            }
          ]
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "API_HOST", "value": "0.0.0.0" },
        { "name": "VITE_ROOT_URL", "value": "https://giglist.dfg.rocks" },
        { "name": "MAIL_PROVIDER", "value": "cloudflare" },
        { "name": "EMAIL_FROM", "value": "GigList <noreply@dfg.rocks>" },
        { "name": "DATABASE_NAME", "value": "giglist" },
        { "name": "DATABASE_OWNER", "database": "giglist", "role": "owner" },
        { "name": "DATABASE_VISITOR", "database": "giglist", "role": "visitor" },
        { "name": "VALKEY_KEY_PREFIX", "valkey": "keyPrefix" },
        { "name": "OTEL_TRACES_EXPORTER", "value": "otlp" },
        { "name": "OTEL_LOGS_EXPORTER", "value": "otlp" }
      ],
      "connections": [],
      "secrets": [
        {
          "_tag": "PostgresCredentials",
          "database": "giglist",
          "login": "migration",
          "urlEnv": "DATABASE_URL"
        },
        {
          "_tag": "PostgresCredentials",
          "database": "giglist",
          "login": "api",
          "urlEnv": "AUTH_DATABASE_URL", "usernameEnv": "DATABASE_AUTHENTICATOR"
        },
        {
          "_tag": "KvSecret",
          "path": "secret/data/giglist",
          "key": "session_secret",
          "env": "SECRET"
        },
        {
          "_tag": "KvSecret",
          "path": "secret/data/giglist",
          "key": "cloudflare_email_api_token",
          "env": "CLOUDFLARE_EMAIL_API_TOKEN"
        },
        { "_tag": "ValkeyCredentials", "urlEnv": "VALKEY_URL" }
      ]
    }
  ],
  "valkey": {}
}
