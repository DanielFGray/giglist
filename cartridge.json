{
  "apiVersion": "server-ansible/v2",
  "name": "giglist",
  "postgres": [{ "database": "giglist", "extensions": ["citext", "pgcrypto", "uuid-ossp"] }],
  "services": [
    {
      "name": "giglist-api",
      "image": "registry.cluster:5000/giglist",
      "hostPort": "dynamic",
      "containerPort": 3000,
      "healthCheck": { "type": "http", "path": "/api/health" },
      "cpu": 300,
      "memoryMB": 384,
      "networkMode": "bridge",
      "command": "bun",
      "args": ["run", "start"],
      "routes": [{ "host": "giglist.dfg.rocks", "pathPrefixes": ["/api"] }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "API_HOST", "value": "0.0.0.0" },
        { "name": "VITE_ROOT_URL", "value": "https://giglist.dfg.rocks" },
        { "name": "MAIL_PROVIDER", "value": "cloudflare" },
        { "name": "EMAIL_FROM", "value": "GigList <noreply@dfg.rocks>" },
        { "name": "DATABASE_NAME", "value": "giglist" },
        { "name": "DATABASE_OWNER", "database": "giglist", "role": "owner" },
        { "name": "DATABASE_VISITOR", "database": "giglist", "role": "visitor" },
        { "name": "OTEL_TRACES_EXPORTER", "value": "otlp" },
        { "name": "OTEL_LOGS_EXPORTER", "value": "otlp" }
      ],
      "connections": [],
      "secrets": [
        {
          "_tag": "PostgresCredentials",
          "database": "giglist",
          "login": "migration",
          "urlEnv": "DATABASE_URL"
        },
        {
          "_tag": "PostgresCredentials",
          "database": "giglist",
          "login": "api",
          "urlEnv": "AUTH_DATABASE_URL"
        },
        {
          "_tag": "KvSecret",
          "path": "secret/data/giglist",
          "key": "session_secret",
          "env": "SECRET"
        },
        {
          "_tag": "KvSecret",
          "path": "secret/data/giglist",
          "key": "cloudflare_email_api_token",
          "env": "CLOUDFLARE_EMAIL_API_TOKEN"
        },
        { "_tag": "ValkeyCredentials", "urlEnv": "VALKEY_URL" }
      ]
    },
    {
      "name": "giglist-worker",
      "image": "registry.cluster:5000/giglist",
      "hostPort": "dynamic",
      "containerPort": 3000,
      "cpu": 200,
      "memoryMB": 256,
      "networkMode": "bridge",
      "command": "bun",
      "args": ["run", "worker:prod"],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "VITE_ROOT_URL", "value": "https://giglist.dfg.rocks" },
        { "name": "MAIL_PROVIDER", "value": "cloudflare" },
        { "name": "EMAIL_FROM", "value": "GigList <noreply@dfg.rocks>" },
        { "name": "OTEL_TRACES_EXPORTER", "value": "otlp" },
        { "name": "OTEL_LOGS_EXPORTER", "value": "otlp" }
      ],
      "connections": [],
      "secrets": [
        {
          "_tag": "PostgresCredentials",
          "database": "giglist",
          "login": "migration",
          "urlEnv": "DATABASE_URL"
        },
        {
          "_tag": "KvSecret",
          "path": "secret/data/giglist",
          "key": "cloudflare_email_api_token",
          "env": "CLOUDFLARE_EMAIL_API_TOKEN"
        },
        { "_tag": "ValkeyCredentials", "urlEnv": "VALKEY_URL" }
      ]
    }
  ],
  "valkey": {}
}
