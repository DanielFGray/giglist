#!/bin/bash
# A fresh worktree, or the tree `ops signoff` exports, has no installed dependencies, no
# generated route tree, and no dev stack. All steps are safe to run again: generateEnvFile
# preserves existing values, `ops dev db up` provisions what is missing, graphile-migrate
# skips applied migrations, and Compose restarts the same Valkey.
set -euo pipefail

bun install --frozen-lockfile
bun scripts/generateRouteTree.ts

bun run env:init
ops dev db up
bun run db:latest
bun run worker:schema
docker compose up -d valkey
