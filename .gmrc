{
  // ops dev db makes each database owned by this group role; the migration login is a member.
  "databaseOwner": "giglist_owner",

  "pgSettings": {
    "search_path": "app_public,app_private,app_hidden,public"
  },

  "placeholders": {
    ":DATABASE_AUTHENTICATOR": "!ENV",
    ":DATABASE_VISITOR": "!ENV"
  },

  "afterReset": [
    // graphile-migrate recreates the shadow database empty; ops rebuilds it from the cartridge.
    { "_": "command", "shadow": true, "command": "ops dev db reset \"$GM_DBNAME\"" },
    "!afterReset.sql"
  ],

  "afterAllMigrations": [],

  "afterCurrent": [],

  "//generatedWith": "0.1.0"
}
