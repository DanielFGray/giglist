[Unit]
Description=GigList email worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=giglist
Group=giglist
WorkingDirectory=/srv/giglist
EnvironmentFile=/etc/giglist.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env bun run worker:prod
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
