{
  "name": "setlist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "predev": "run-s -s db:ensure",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bunx playwright test",
    "test:ui": "bunx playwright test --ui",
    "env:init": "bun scripts/generateEnvFile.ts",
    "gm": "bun -b graphile-migrate",
    "db:up": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:exec": "docker compose exec db",
    "db:init": "bun scripts/dbSetup.ts",
    "db:ensure": "bun scripts/dbEnsure.ts",
    "db:latest": "bun -b graphile-migrate watch --once",
    "db:watch": "bun -b graphile-migrate watch",
    "db:reset": "bun -b graphile-migrate reset --erase",
    "sourcerer": "bun -b pgsourcerer",
    "db:setup": "run-s db:up db:init worker:schema db:reset db:latest",
    "worker": "cd worker && bun --env-file=../.env graphile-worker",
    "worker:schema": "cd worker && bun --env-file=../.env graphile-worker --schema-only",
    "init": "NOCONFIRM=1 run-s env:init db:setup"
  },
  "dependencies": {
    "@danielfgray/pg-sourcerer": "link:@danielfgray/pg-sourcerer",
    "@effect/platform": "^0.95.0",
    "@effect/platform-node": "^0.105.0",
    "@effect/sql": "^0.50.0",
    "@effect/sql-kysely": "^0.46.0",
    "@effect/sql-pg": "^0.51.0",
    "@tanstack/query-db-collection": "^1.0.30",
    "@tanstack/react-db": "^0.1.77",
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-router": "^1.121.0",
    "@tanstack/react-start": "^1.121.0",
    "effect": "^3.19.19",
    "graphile-migrate": "^2.0.0-rc.2",
    "graphile-worker": "^0.16.6",
    "html-to-text": "^9.0.5",
    "kysely": "^0.28.11",
    "lodash.template": "^4.5.0",
    "mjml": "^4.18.0",
    "nodemailer": "^8.0.3",
    "npm-run-all": "^4.1.5",
    "pg": "^8.18.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.9.3"
  }
}
