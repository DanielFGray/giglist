{
  "name": "giglist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench:voicing": "bun scripts/benchVoicing.ts",
    "build": "bun run client:build",
    "check:production": "bash scripts/checkProduction.sh",
    "client:build": "vite build",
    "server:build": "vite build",
    "db:ensure": "bun scripts/dbEnsure.ts",
    "db:psql": "ops dev db psql",
    "db:init": "bun scripts/dbSetup.ts",
    "db:latest": "bun --env-file=.env -b graphile-migrate watch --once",
    "db:reset": "ops dev db reset giglist_dev && bun run db:latest && bun run worker:schema",
    "db:setup": "run-s db:up db:latest worker:schema",
    "db:up": "ops dev db up",
    "db:watch": "bun --env-file=.env -b graphile-migrate watch",
    "predev": "run-s -s db:ensure",
    "dev": "run-p -s dev:client dev:server db:watch",
    "dev:client": "bun --env-file=.env -b vite",
    "dev:server": "bun --watch src/server/main.ts",
    "env:init": "bun scripts/generateEnvFile.ts",
    "gm": "bun --env-file=.env -b graphile-migrate",
    "migrate": "graphile-migrate migrate",
    "init": "NOCONFIRM=1 run-s env:init db:setup",
    "lint": "oxlint --type-aware",
    "prepare": "run-s prepare:patch prepare:hooks",
    "start": "NODE_ENV=production bun src/server/main.ts",
    "test": "bunx playwright test",
    "test:api": "bun --env-file=.env -b vitest run",
    "test:clean": "bun scripts/testClean.ts",
    "test:client": "bun run build && bun --env-file=.env -b vite preview",
    "test:db": "bash tests/db/run.sh",
    "test:mail": "bun test worker",
    "test:ui": "bunx playwright test --ui",
    "test:unit": "bun test src --path-ignore-patterns='**/*.api.test.ts'",
    "typecheck": "tsc --noEmit",
    "worker:schema": "cd worker && bun --env-file=../.env graphile-worker --schema-only",
    "prepare:patch": "effect-tsgo patch --typescript --oxlint",
    "prepare:hooks": "git rev-parse --git-dir >/dev/null 2>&1 || exit 0; lefthook install --reset-hooks-path"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1166.0",
    "@coderline/alphatab": "1.9.0-alpha.1891",
    "@effect/platform-bun": "^4.1.3",
    "@effect/platform-node": "^4.1.3",
    "@effect/sql-pg": "^4.1.3",
    "@tanstack/query-db-collection": "^1.5.1",
    "@tanstack/react-db": "^1.0.0-rc.1.4",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.46",
    "@vitejs/plugin-react": "^6.3.0",
    "alphatab-kit": "github:DanielFGray/alphatab-kit#v0.1.0",
    "chordsheetjs": "18.0.0",
    "diff-match-patch": "1.0.5",
    "effect": "^4.1.3",
    "graphile-migrate": "^2.0.0-rc.6",
    "graphile-worker": "^0.18.0",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^12.0.0",
    "kysely": "^0.29.8",
    "kysely-codegen": "^0.20.0",
    "lodash.template": "^4.18.1",
    "markdown-it": "^15.0.3",
    "mjml": "^5.4.1",
    "nodemailer": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "perfect-freehand": "1.2.3",
    "react": "^19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.67.7",
    "@effect/vitest": "4.1.3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-generator": "1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/bun": "^1.4.4",
    "@types/diff-match-patch": "1.0.36",
    "@types/html-to-text": "^9.0.4",
    "@types/lodash.template": "^4.5.3",
    "@types/mjml": "^5.4.2",
    "@types/mjml-core": "^5.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lefthook": "^2.2.2",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "smtp-server": "^3.21.4",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  },
  "patchedDependencies": {
    "@coderline/alphatab@1.9.0-alpha.1891": "patches/@coderline%2Falphatab@1.9.0-alpha.1891.patch"
  },
  "projectName": "GigList"
}
