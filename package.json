{
  "name": "giglist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench:voicing": "bun scripts/benchVoicing.ts",
    "build": "bun run client:build",
    "check:production": "bash scripts/checkProduction.sh",
    "check:production:local": "bash scripts/checkProductionLocal.sh",
    "client:build": "vite build",
    "server:build": "vite build",
    "db:ensure": "bun scripts/dbEnsure.ts",
    "db:exec": "docker compose exec db",
    "db:init": "bun scripts/dbSetup.ts",
    "db:latest": "bun --env-file=.env -b graphile-migrate watch --once",
    "db:reset": "bun --env-file=.env -b graphile-migrate reset --erase",
    "db:setup": "run-s db:up db:init db:reset db:latest worker:schema",
    "db:stop": "docker compose stop db",
    "db:up": "docker compose up -d db",
    "db:watch": "bun --env-file=.env -b graphile-migrate watch",
    "predev": "run-s -s db:ensure",
    "dev": "run-p -s dev:client dev:server db:watch worker",
    "dev:client": "bun --env-file=.env -b vite",
    "dev:server": "bun --watch src/server/main.ts",
    "env:init": "bun scripts/generateEnvFile.ts",
    "gm": "bun --env-file=.env -b graphile-migrate",
    "init": "NOCONFIRM=1 run-s env:init db:setup",
    "lint": "oxlint --type-aware",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "start": "NODE_ENV=production bun src/server/main.ts",
    "test": "bunx playwright test",
    "test:clean": "bun scripts/testClean.ts",
    "test:client": "bun run build && bun --env-file=.env -b vite preview",
    "test:db": "bash tests/db/run.sh",
    "test:mail": "bun test worker",
    "test:ui": "bunx playwright test --ui",
    "test:unit": "bun test src",
    "typecheck": "tsc --noEmit",
    "worker": "bun --env-file=.env worker/main.ts",
    "worker:prod": "NODE_ENV=production bun worker/main.ts",
    "worker:schema": "cd worker && bun --env-file=../.env graphile-worker --schema-only"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1153.0",
    "@coderline/alphatab": "1.9.0-alpha.1891",
    "@effect/platform-bun": "^4.0.5",
    "@effect/platform-node": "^4.0.5",
    "@effect/sql-pg": "^4.0.5",
    "@tanstack/query-db-collection": "^1.4.7",
    "@tanstack/react-db": "^0.1.96",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.45",
    "@vitejs/plugin-react": "^6.1.2",
    "chordsheetjs": "18.0.0",
    "diff-match-patch": "1.0.5",
    "effect": "^4.0.5",
    "graphile-migrate": "^2.0.0-rc.2",
    "graphile-worker": "^0.18.0",
    "html-to-text": "^9.0.5",
    "htmlparser2": "^12.0.0",
    "kysely": "^0.29.7",
    "kysely-codegen": "^0.20.0",
    "lodash.template": "^4.18.1",
    "markdown-it": "^15.0.3",
    "mjml": "^4.18.0",
    "nodemailer": "^8.0.11",
    "npm-run-all": "^4.1.5",
    "perfect-freehand": "1.2.3",
    "react": "^19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.54.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.47",
    "@types/bun": "^1.4.3",
    "@types/diff-match-patch": "1.0.36",
    "@types/html-to-text": "^9.0.4",
    "@types/lodash.template": "^4.5.3",
    "@types/mjml": "4",
    "@types/mjml-core": "4",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "smtp-server": "^3.20.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2"
  },
  "patchedDependencies": {
    "@coderline/alphatab@1.9.0-alpha.1891": "patches/@coderline%2Falphatab@1.9.0-alpha.1891.patch"
  },
  "projectName": "GigList",
  "overrides": {
    "@types/mjml-core": "4.15.2"
  }
}
