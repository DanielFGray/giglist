{
  "name": "setlist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "predev": "run-s -s db:ensure",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "env:init": "bun scripts/generateEnvFile.ts",
    "gm": "bun -b graphile-migrate",
    "db:up": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:exec": "docker compose exec db",
    "db:init": "bun scripts/dbSetup.ts",
    "db:ensure": "bun scripts/dbEnsure.ts",
    "db:latest": "bun -b graphile-migrate watch --once",
    "db:watch": "bun -b graphile-migrate watch",
    "db:reset": "bun -b graphile-migrate reset --erase",
    "db:types": "kysely-codegen",
    "sourcerer": "bun -b pgsourcerer",
    "db:setup": "run-s db:up db:init db:reset db:latest",
    "worker": "cd worker && bun --env-file=../.env graphile-worker",
    "worker:schema": "cd worker && bun --env-file=../.env graphile-worker --schema-only",
    "init": "NOCONFIRM=1 run-s env:init db:setup worker:schema"
  },
  "dependencies": {
    "@danielfgray/pg-sourcerer": "link:@danielfgray/pg-sourcerer",
    "@effect/platform": "^0.94.5",
    "@effect/platform-node": "^0.104.1",
    "@effect/sql": "^0.49.0",
    "@effect/sql-kysely": "^0.45.0",
    "@effect/sql-pg": "^0.50.3",
    "@tanstack/query-db-collection": "^0.0.3",
    "@tanstack/react-db": "^0.0.3",
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-router": "^1.121.0",
    "@tanstack/react-start": "^1.121.0",
    "effect": "^3.19.19",
    "graphile-migrate": "^2.0.0-rc.2",
    "graphile-worker": "^0.16.6",
    "html-to-text": "^9.0.5",
    "kysely": "^0.28.11",
    "lodash.template": "^4.5.0",
    "mjml": "^4.18.0",
    "nodemailer": "^8.0.3",
    "npm-run-all": "^4.1.5",
    "pg": "^8.18.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "kysely-codegen": "^0.18.1",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.8.3"
  }
}
