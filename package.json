{
  "name": "setlist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p -s dev:client dev:server",
    "dev:client": "bun --env-file=.env -b vite",
    "dev:server": "bun --watch src/server/main.ts",
    "predev": "run-s -s db:ensure",
    "build": "vite build",
    "start": "bun src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bunx playwright test",
    "test:ui": "bunx playwright test --ui",
    "env:init": "bun scripts/generateEnvFile.ts",
    "gm": "bun --env-file=.env -b graphile-migrate",
    "db:up": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:exec": "docker compose exec db",
    "db:init": "bun scripts/dbSetup.ts",
    "db:ensure": "bun scripts/dbEnsure.ts",
    "db:latest": "bun --env-file=.env -b graphile-migrate watch --once",
    "db:watch": "bun --env-file=.env -b graphile-migrate watch",
    "db:reset": "bun --env-file=.env -b graphile-migrate reset --erase",
    "sourcerer": "bun --env-file=.env -b pgsourcerer",
    "db:setup": "run-s db:up db:init db:reset db:latest worker:schema",
    "worker": "cd worker && bun --env-file=../.env graphile-worker",
    "worker:schema": "cd worker && bun --env-file=../.env graphile-worker --schema-only",
    "init": "NOCONFIRM=1 run-s env:init db:setup"
  },
  "dependencies": {
    "@danielfgray/pg-sourcerer": "file:../pg-sourcerer",
    "@effect/platform": "^0.97.1",
    "@effect/platform-bun": "^0.91.2",
    "@effect/platform-node": "^0.108.1",
    "@effect/sql": "^0.52.1",
    "@effect/sql-kysely": "^0.48.0",
    "@effect/sql-pg": "^0.53.0",
    "@tanstack/query-db-collection": "^1.2.1",
    "@tanstack/react-db": "^0.1.95",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "@vitejs/plugin-react": "^6.0.5",
    "effect": "^3.22.1",
    "graphile-migrate": "^2.0.0-rc.2",
    "graphile-worker": "^0.17.3",
    "html-to-text": "^9.0.5",
    "kysely": "^0.29.5",
    "kysely-codegen": "^0.20.0",
    "lodash.template": "^4.18.1",
    "mjml": "^4.18.0",
    "nodemailer": "^8.0.3",
    "npm-run-all": "^4.1.5",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.29",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2"
  }
}
